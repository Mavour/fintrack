{
  "name": "dompet-saya",
  "version": "1.0.0",
  "description": "Dompet Saya - dashboard keuangan + portofolio self-hosted",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/copy-schema.mjs",
    "start": "node dist/server/index.js",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\"",
    "db:migrate": "node dist/server/db/migrate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "yahoo-finance2": "^2.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}

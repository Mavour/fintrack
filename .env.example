# Server
PORT=3100
HOST=127.0.0.1
DATABASE_PATH=./data/app.db
SESSION_SECRET=change-me-to-32-chars-minimum
APP_PASSWORD=change-me-on-first-run
NODE_ENV=production
# Skrip demo (seed/shot/clean) menolak berjalan kecuali DEMO_MODE=true.
DEMO_MODE=false

# Price providers
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=
# Free read-only key from https://etherscan.io (menu API-KEYs). Only needed for
# Hoodi testnet wallet sync; mainnets use keyless explorers.
BINANCE_ENABLED=true
YAHOO_ENABLED=true
FX_CACHE_TTL_MS=3600000
CRYPTO_REFRESH_CRON=*/1 * * * *
STOCK_REFRESH_CRON=*/5 * * * *

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Wallet tracker (read-only, alamat publik saja — JANGAN isi private key/seed)
# Opsional: JSON array {label, address}; kosongkan jika memakai snapshot privat.
# Wallet dipulihkan dari snapshot privat atau ditambahkan sendiri di aplikasi.
SEED_WALLETS=[]
JUPITER_API_KEY=
DEBANK_ACCESS_KEY=
DEBANK_DAILY_UNIT_BUDGET=0
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Kinetiq Elysium mainnet (chain 99901, gas HYPE), read-only RPC.
ELYSIUM_RPC_URL=https://rpc.elysium.kinetiq.xyz
ROBINHOOD_RPC_URL=https://robinhood.rpc.pinax.network
WALLET_SOLANA_CRON=*/5 * * * *
WALLET_EVM_CRON=*/10 * * * *
WALLET_SYNC_COOLDOWN_MS=30000
METEORA_DLMM_BASE=https://dlmm.datapi.meteora.ag
METEORA_DAMM_V2_BASE=https://damm-v2.datapi.meteora.ag

# Sinkronisasi bertingkat (detik, minimum 10 — nilai lebih kecil dijepit otomatis)
PRICE_REFRESH_SEC=15
LP_REFRESH_SEC=15
SOL_REFRESH_SEC=15
EVM_REFRESH_SEC=15
# Sync EVM tanpa DEBANK_ACCESS_KEY memakai explorer Blockscout publik; tiap
# chain di-refresh paling cepat sekali per interval ini (ms) agar tidak
# kena rate-limit. Pace antar chain (ms) juga bisa disetel.
EVM_EXPLORER_CHAIN_INTERVAL=120000
EVM_EXPLORER_PACE_MS=600
# Override host explorer per chain bila instance publik default di-rate-limit
# (format sama: base http(s) tanpa akhiran /api). Contoh:
# EVM_EXPLORER_ETH_URL=https://eth.example.org
# EVM_EXPLORER_OP_URL=https://optimism.example.org

# Agent Dorm / Karo: separate read-only API (no account/transaction controls)
# Disabled by default until STATUS_API_KEY is configured. This key is separate
# from APP_PASSWORD / SESSION_SECRET. Keep it private and use it in Dorm too.
STATUS_API_ENABLED=false
STATUS_API_HOST=127.0.0.1
STATUS_API_PORT=9002
STATUS_API_KEY=
STATUS_API_DAY_TIMEZONE=Asia/Makassar
STATUS_API_FX_MAX_AGE_SEC=86400
# Optional real monthly spending budget in IDR; blank = not configured.
STATUS_API_MONTHLY_BUDGET_IDR=
